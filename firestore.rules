rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Insured persons - users can only access their own insured persons
    match /insured_persons/{personId} {
      allow read, write: if isAuthenticated() &&
        (resource.data.appUserId == request.auth.uid ||
         request.resource.data.appUserId == request.auth.uid);
    }

    // Policies - users can only access policies for their insured persons
    match /policies/{policyId} {
      allow read, write: if isAuthenticated();
    }

    // Insurers - read-only for all authenticated users (master data)
    match /insurers/{insurerId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins should write insurers (handle separately if needed)
    }

    // Claims - users can only access their own claims
    match /claims/{claimId} {
      allow read, write: if isAuthenticated() &&
        (resource.data.appUserId == request.auth.uid ||
         request.resource.data.appUserId == request.auth.uid);

      // Attachments subcollection - users can access attachments for their claims
      match /attachments/{attachmentId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Email logs - users can only read their own email logs
    match /email_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions should write logs
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
